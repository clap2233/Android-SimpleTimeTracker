<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?appBackgroundColor">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/settingsBack" style="@style/LifeClockUi2Button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:text="‹" android:contentDescription="返回设置" android:visibility="gone" />
        <TextView android:id="@+id/settingsSectionTitle" style="@style/LifeClockUi2Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="设置" />
        <ImageView style="@style/LifeClockUi2Illustration" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/life_clock_cat_tea" android:importantForAccessibility="no" />
    </LinearLayout>
    <ScrollView android:id="@+id/settingsHome" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp">
            <FrameLayout android:id="@+id/settingsActivities" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:background="@drawable/life_clock_ui2_card" android:foreground="?selectableItemBackground"
                android:clickable="true" android:focusable="true" android:contentDescription="活动与模板，分类、标签、模板与归档">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="84dp" android:padding="16dp" android:gravity="center_vertical" android:importantForAccessibility="noHideDescendants">
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="44dp" android:layout_height="44dp"
                        android:padding="10dp" android:background="@drawable/life_clock_ui2_accent"
                        app:srcCompat="@drawable/life_clock_ui2_setting_activity" app:tint="?appTabSelectedColor" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="8dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="活动与模板"
                            android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="?appTextPrimaryColor" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="分类、标签、模板与归档"
                            android:textSize="12sp" android:paddingTop="5dp" android:textColor="?appTextHintColor" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="20dp" android:layout_height="20dp"
                        app:srcCompat="@drawable/life_clock_ui2_setting_chevron" app:tint="?appTextHintColor" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/settingsReminders" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:background="@drawable/life_clock_ui2_card" android:foreground="?selectableItemBackground"
                android:clickable="true" android:focusable="true" android:contentDescription="提醒与计时，轻提醒、免打扰与通知">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="84dp" android:padding="16dp" android:gravity="center_vertical" android:importantForAccessibility="noHideDescendants">
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="44dp" android:layout_height="44dp"
                        android:padding="10dp" android:background="@drawable/life_clock_ui2_soft"
                        app:srcCompat="@drawable/life_clock_ui2_setting_bell" app:tint="?appTabSelectedColor" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="8dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="提醒与计时"
                            android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="?appTextPrimaryColor" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="轻提醒、免打扰与通知"
                            android:textSize="12sp" android:paddingTop="5dp" android:textColor="?appTextHintColor" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="20dp" android:layout_height="20dp"
                        app:srcCompat="@drawable/life_clock_ui2_setting_chevron" app:tint="?appTextHintColor" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/settingsAppearance" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:background="@drawable/life_clock_ui2_card" android:foreground="?selectableItemBackground"
                android:clickable="true" android:focusable="true" android:contentDescription="外观与显示，主题、语言与显示偏好">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="84dp" android:padding="16dp" android:gravity="center_vertical" android:importantForAccessibility="noHideDescendants">
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="44dp" android:layout_height="44dp"
                        android:padding="10dp" android:background="@drawable/life_clock_ui2_accent"
                        app:srcCompat="@drawable/life_clock_ui2_setting_leaf" app:tint="?appTabSelectedColor" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="8dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="外观与显示"
                            android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="?appTextPrimaryColor" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="主题、语言与显示偏好"
                            android:textSize="12sp" android:paddingTop="5dp" android:textColor="?appTextHintColor" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="20dp" android:layout_height="20dp"
                        app:srcCompat="@drawable/life_clock_ui2_setting_chevron" app:tint="?appTextHintColor" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/settingsData" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:background="@drawable/life_clock_ui2_card" android:foreground="?selectableItemBackground"
                android:clickable="true" android:focusable="true" android:contentDescription="数据与备份，完整备份、恢复与电脑查看">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="84dp" android:padding="16dp" android:gravity="center_vertical" android:importantForAccessibility="noHideDescendants">
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="44dp" android:layout_height="44dp"
                        android:padding="10dp" android:background="@drawable/life_clock_ui2_soft"
                        app:srcCompat="@drawable/life_clock_ui2_setting_backup" app:tint="?appTabSelectedColor" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="8dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="数据与备份"
                            android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="?appTextPrimaryColor" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="完整备份、恢复与电脑查看"
                            android:textSize="12sp" android:paddingTop="5dp" android:textColor="?appTextHintColor" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="20dp" android:layout_height="20dp"
                        app:srcCompat="@drawable/life_clock_ui2_setting_chevron" app:tint="?appTextHintColor" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/settingsAdvanced" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:background="@drawable/life_clock_ui2_card" android:foreground="?selectableItemBackground"
                android:clickable="true" android:focusable="true" android:contentDescription="高级设置，自动化、规则与批量编辑">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="84dp" android:padding="16dp" android:gravity="center_vertical" android:importantForAccessibility="noHideDescendants">
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="44dp" android:layout_height="44dp"
                        android:padding="10dp" android:background="@drawable/life_clock_ui2_accent"
                        app:srcCompat="@drawable/life_clock_ui2_setting_tune" app:tint="?appTabSelectedColor" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="8dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="高级设置"
                            android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="?appTextPrimaryColor" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="自动化、规则与批量编辑"
                            android:textSize="12sp" android:paddingTop="5dp" android:textColor="?appTextHintColor" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="20dp" android:layout_height="20dp"
                        app:srcCompat="@drawable/life_clock_ui2_setting_chevron" app:tint="?appTextHintColor" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/settingsAbout" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                android:background="@drawable/life_clock_ui2_card" android:foreground="?selectableItemBackground"
                android:clickable="true" android:focusable="true" android:contentDescription="关于与帮助，使用说明、版本与开源许可">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="84dp" android:padding="16dp" android:gravity="center_vertical" android:importantForAccessibility="noHideDescendants">
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="44dp" android:layout_height="44dp"
                        android:padding="10dp" android:background="@drawable/life_clock_ui2_soft"
                        app:srcCompat="@drawable/life_clock_ui2_setting_heart" app:tint="?appTabSelectedColor" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="8dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="关于与帮助"
                            android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="?appTextPrimaryColor" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="使用说明、版本与开源许可"
                            android:textSize="12sp" android:paddingTop="5dp" android:textColor="?appTextHintColor" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="20dp" android:layout_height="20dp"
                        app:srcCompat="@drawable/life_clock_ui2_setting_chevron" app:tint="?appTextHintColor" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
    <androidx.core.widget.NestedScrollView android:id="@+id/settingsSection" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
            <LinearLayout android:id="@+id/settingsBackupActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.button.MaterialButton android:id="@+id/lifeClockBackupButton" style="@style/LifeClockUi2DetailButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/life_clock_full_backup" />
                <com.google.android.material.button.MaterialButton android:id="@+id/lifeClockCloudBackupButton" style="@style/LifeClockUi2DetailButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="手动云备份与电脑查看" />
            </LinearLayout>
            <LinearLayout android:id="@+id/settingsAboutContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="生活时间钟&#10;记录生活，留住值得的时光。" android:textSize="18sp" android:padding="16dp" android:textColor="?appTextPrimaryColor" />
                <com.google.android.material.button.MaterialButton android:id="@+id/settingsHelp" style="@style/LifeClockUi2Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="简明使用说明" />
                <com.google.android.material.button.MaterialButton android:id="@+id/settingsLicense" style="@style/LifeClockUi2Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="项目来源与开源许可" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/rvSettingsContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
