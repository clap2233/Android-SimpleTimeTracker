<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="8dp" android:paddingBottom="12dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="这段经历" android:textSize="20sp" android:fontFamily="sans-serif-medium"
        android:textColor="?appTextPrimaryColor" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="留下一点感受，也可以留白" android:textSize="13sp"
        android:textColor="?appTextHintColor" android:paddingTop="4dp" android:paddingBottom="12dp" />
    <TextView android:id="@+id/lifeClockUnfinishedStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="未完成专注 · 不计入正式总时长；编辑详情会保留此状态。"
        android:textSize="14sp" android:textColor="?appTextPrimaryColor"
        android:paddingBottom="12dp" android:visibility="gone" />
    <com.google.android.material.textfield.TextInputLayout
        style="@style/LifeClockUi2Input" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="一句话记下这段经历">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/lifeClockSummaryInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3" android:textSize="16sp" android:minHeight="64dp" />
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/lifeClockHappinessButton" style="@style/LifeClockUi2DetailButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:text="@string/life_clock_happiness_entry"
            app:backgroundTint="?lifeClockApricotSurfaceColor" app:icon="@drawable/life_clock_ui2_happy" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/lifeClockMeaningButton" style="@style/LifeClockUi2DetailButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" android:text="@string/life_clock_meaning_entry"
            app:backgroundTint="?lifeClockAccentSurfaceColor" app:icon="@drawable/life_clock_ui2_meaning" />
    </LinearLayout>
    <TextView android:id="@+id/lifeClockCombinedScore" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:textSize="14sp" android:textColor="?appTextPrimaryColor" />
    <com.google.android.material.button.MaterialButton android:id="@+id/lifeClockRecoveryButton" style="@style/LifeClockUi2DetailButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="恢复感 · 未填写" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/lifeClockPhotosButton" style="@style/LifeClockUi2DetailButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/life_clock_photo_entry" app:icon="@drawable/life_clock_ui2_photo" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/lifeClockPeopleButton" style="@style/LifeClockUi2DetailButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="人物 · 未选择" app:icon="@drawable/life_clock_ui2_people" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/lifeClockEnvironmentButton" style="@style/LifeClockUi2DetailButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="环境 · 未选择" app:icon="@drawable/life_clock_ui2_place" />
</LinearLayout>
