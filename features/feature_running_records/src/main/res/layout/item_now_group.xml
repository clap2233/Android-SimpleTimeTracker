<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.example.util.simpletimetracker.feature_views.IconView
            android:id="@+id/nowGroupIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:padding="6dp"
            android:importantForAccessibility="no" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/nowGroupTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:textColor="?appTextPrimaryColor"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nowGroupStart"
            style="@style/LifeClockUi2Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nowGroupPolicy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textColor="?appTextHintColor"
        android:textSize="12sp" />
</LinearLayout>
