<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="12dp"
        android:alpha="?lifeClockIllustrationAlpha"
        android:src="@drawable/life_clock_cat_sleep"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEmptyItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?appTextPrimaryColor"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvEmptyItemHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?appTextHintColor"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
