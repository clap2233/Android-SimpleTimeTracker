<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LifeClockUi2Title">
        <item name="android:textSize">23sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">?appTextPrimaryColor</item>
    </style>
    <style name="LifeClockUi2Button" parent="LifeClockButton">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">?lifeClockSoftSurfaceColor</item>
        <item name="iconTint">?appTabSelectedColor</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">8dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>
    <style name="LifeClockUi2PrimaryButton" parent="LifeClockUi2Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">?appActiveColor</item>
        <item name="iconTint">@color/white</item>
    </style>
    <style name="LifeClockUi2SegmentButton" parent="LifeClockUi2Button">
        <item name="backgroundTint">@color/life_clock_ui2_segment_background</item>
        <item name="android:textColor">?appTextPrimaryColor</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="LifeClockUi2DetailButton" parent="LifeClockUi2Button">
        <item name="backgroundTint">?appCardBackgroundColor</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="iconGravity">start</item>
        <item name="android:minHeight">60dp</item>
    </style>
    <style name="LifeClockUi2Illustration">
        <item name="android:alpha">?lifeClockIllustrationAlpha</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="LifeClockUi2Input" parent="ChangeItemInputField">
        <item name="boxCornerRadiusBottomEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item>
        <item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusTopStart">20dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxBackgroundColor">?appCardBackgroundColor</item>
        <item name="hintTextColor">?appTextHintColor</item>
    </style>
</resources>
