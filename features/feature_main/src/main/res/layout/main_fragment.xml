<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/containerMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/mainTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:tabIndicatorColor="?appTabSelectedColor"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="0dp"
        android:background="?appCardBackgroundColor"
        app:tabTextColor="?appTabUnselectedColor"
        app:tabSelectedTextColor="?appTabSelectedColor"
        app:tabRippleColor="@color/tab_ripple" />

    <View
        android:id="@+id/mainTabsDivider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="?appDividerColor"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/mainTabs"
        tools:visibility="visible" />

    <!--  Small margin is added to prevent shared transition going under new screen  -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/mainPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="0.1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mainTabs" />

</androidx.constraintlayout.widget.ConstraintLayout>
