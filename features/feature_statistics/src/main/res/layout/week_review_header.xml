<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/LifeClockUi2Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="这一周的小记" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="留住喜欢的，也试着调整。"
            android:textColor="?appTextHintColor"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/reviewJournalCat"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:alpha="?lifeClockIllustrationAlpha"
        android:src="@drawable/life_clock_cat_journal" />
</LinearLayout>
